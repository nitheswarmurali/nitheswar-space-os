# ORBIT OS — environment variables
# Copy to .env.local and fill in the values you have.

# ── YouTube Data API v3 (fixes live-status verification) ──
# Get a free key: https://console.cloud.google.com/apis/credentials
# 1. Create a project
# 2. Enable "YouTube Data API v3"
# 3. Create an API key (restrict to YouTube Data API v3 for safety)
# Free quota: 10,000 units/day (~100 live-status checks/day)
YOUTUBE_API_KEY=

# ── Optional ──
LAUNCH_LIBRARY_API_KEY=
NASA_API_KEY=DEMO_KEY

# ── App defaults ──
NEXT_PUBLIC_DEFAULT_TIMEZONE=Asia/Kolkata
NEXT_PUBLIC_DEFAULT_LOCALE=en